{
  "agents": {
    "subagentAllowedTools": ["Read", "Grep", "Glob"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[hook] ファイルが変更されました\""
          }
        ]
      }
    ]
  }
}
